{
  "name": "sftp-git",
  "displayName": "sftp-git",
  "description": "SFTPアップロードとGit管理を統合し、AI差分解析等の中核機能をRust製LSPサーバーで提供する拡張機能。業務ロジックは持たず、LSPサーバー(sftp_git_lsp)への薄い接続層のみ。",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sftpGit.cleanupAdvice",
        "title": "sftp-git: 不要ファイルAI削除判定支援 (Cleanup Advice)"
      },
      {
        "command": "sftpGit.detectDrift",
        "title": "sftp-git: SFTPドリフト検出 (Detect Drift)"
      },
      {
        "command": "sftpGit.versionlessResolve",
        "title": "sftp-git: VersionlessAPI変換 (Versionless Resolve)"
      },
      {
        "command": "sftpGit.analyzeDiff",
        "title": "sftp-git: AI差分解析 (Analyze Diff)"
      },
      {
        "command": "sftpGit.dualDatabaseState",
        "title": "sftp-git: DUAL DATABASE状態確認 (Dual Database State)"
      },
      {
        "command": "sftpGit.dualDatabaseOnPrimaryFailureDetected",
        "title": "sftp-git: DUAL DATABASE主系障害を通知 (Dual Database: Report Primary Failure)"
      },
      {
        "command": "sftpGit.dualDatabaseOnRecoveredAndResynced",
        "title": "sftp-git: DUAL DATABASE復旧・再同期を通知 (Dual Database: Report Recovered)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
