{
  "name": "sftp-git",
  "displayName": "sftp-git",
  "description": "SFTPアップロードとGit管理を統合し、AI差分解析等の中核機能をRust製LSPサーバーで提供する拡張機能。業務ロジックは持たず、LSPサーバー(sftp_git_lsp)への薄い接続層のみ。",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
